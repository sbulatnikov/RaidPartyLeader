<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
	<Name>CloseButton</Name>
	<Placement>
		<X>
			<Size>34</Size>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<HighPos>8</HighPos>
		</X>
		<Y>
			<Pos>8</Pos>
			<Size>34</Size>
		</Y>
	</Placement>
	<IgnoreDblClick>true</IgnoreDblClick>
	<TextTag>button_label</TextTag>
	<Variants>
		<Item>
			<TextFileRef href="../Texts/CloseButton.txt" />
			<LayerHighlight href="Textures/GhostHover.Frame_6_6_6_6.(WidgetLayerTiledTexture).xdb" />
			<PushedOffset x="0" y="1" />
			<StateNormal>
				<LayerMain href="Textures/Transparent.Stretch.(WidgetLayerSimpleTexture).xdb" />
				<FormatFileRef href="../Texts/CloseButton.Format.txt" />
			</StateNormal>
			<StatePushed>
				<LayerMain href="Textures/GhostHover.Frame_6_6_6_6.(WidgetLayerTiledTexture).xdb" />
			</StatePushed>
			<StateDisabled>
				<LayerMain href="Textures/Transparent.Stretch.(WidgetLayerSimpleTexture).xdb" />
				<FormatFileRef href="../Texts/CloseButton.Disabled.txt" />
			</StateDisabled>
			<Reaction>rpl_close</Reaction>
			<ReactionOnUp>true</ReactionOnUp>
		</Item>
	</Variants>
	<TextStyle>
		<Align>ALIGNY_MIDDLE</Align>
	</TextStyle>
	<Children>
