<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
	<Name>QuickSaveButton</Name>
	<Placement>
		<X>
			<Size>120</Size>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<HighPos>146</HighPos>
		</X>
		<Y>
			<Pos>24</Pos>
			<Size>36</Size>
		</Y>
	</Placement>
	<IgnoreDblClick>true</IgnoreDblClick>
	<TextTag>button_label</TextTag>
	<Variants>
		<Item>
			<TextFileRef href="../Texts/QuickSaveButton.txt" />
			<LayerHighlight href="Textures/BtnAccentHover.Frame_7_7_7_7.(WidgetLayerTiledTexture).xdb" />
			<PushedOffset x="0" y="1" />
			<StateNormal>
				<LayerMain href="Textures/BtnAccentNormal.Frame_7_7_7_7.(WidgetLayerTiledTexture).xdb" />
				<FormatFileRef href="../Texts/QuickSaveButton.Format.txt" />
			</StateNormal>
			<StatePushed>
				<LayerMain href="Textures/BtnAccentPressed.Frame_7_7_7_7.(WidgetLayerTiledTexture).xdb" />
			</StatePushed>
			<StateDisabled>
				<LayerMain href="Textures/BtnAccentDisabled.Frame_7_7_7_7.(WidgetLayerTiledTexture).xdb" />
				<FormatFileRef href="../Texts/QuickSaveButton.Disabled.txt" />
			</StateDisabled>
			<Reaction>rpl_quick_save</Reaction>
			<ReactionOnUp>true</ReactionOnUp>
		</Item>
	</Variants>
	<TextStyle>
		<Align>ALIGNY_MIDDLE</Align>
	</TextStyle>
	<Visible>false</Visible>
</WidgetButton>
