<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
	<Name>RetryButton</Name>
	<Placement>
		<X>
			<Size>26</Size>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<HighPos>7</HighPos>
		</X>
		<Y>
			<Pos>5</Pos>
			<Size>26</Size>
		</Y>
	</Placement>
	<IgnoreDblClick>true</IgnoreDblClick>
	<TextTag>button_label</TextTag>
	<Variants>
		<Item>
			<TextFileRef href="../Texts/RetryButton.txt" />
