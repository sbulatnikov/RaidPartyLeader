<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
	<Name>AutoRetryCheck</Name>
	<Placement>
		<X>
			<Size>144</Size>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<HighPos>0</HighPos>
		</X>
		<Y>
			<Pos>16</Pos>
			<Size>36</Size>
		</Y>
	</Placement>
	<IgnoreDblClick>true</IgnoreDblClick>
	<TextTag>button_label</TextTag>
	<Variants>
		<Item>
			<TextFileRef href="../Texts/AutoRetryCheck.txt" />
			<PushedOffset x="0" y="1" />
			<StateNormal>
				<LayerMain href="Textures/Transparent.Stretch.(WidgetLayerSimpleTexture).xdb" />
				<FormatFileRef href="../Texts/AutoRetryCheck.Format.txt" />
			</StateNormal>
			<StatePushed>
				<LayerMain href="Textures/Transparent.Stretch.(WidgetLayerSimpleTexture).xdb" />
			</StatePushed>
			<StateDisabled>
				<LayerMain href="Textures/Transparent.Stretch.(WidgetLayerSimpleTexture).xdb" />
				<FormatFileRef href="../Texts/AutoRetryCheck.Disabled.txt" />
			</StateDisabled>
			<Reaction>rpl_auto</Reaction>
			<ReactionOnUp>true</ReactionOnUp>
		</Item>
	</Variants>
	<TextStyle>
		<Align>ALIGNY_MIDDLE</Align>
	</TextStyle>
	<Children>
		<Item href="AutoRetryLabel.(WidgetTextView).xdb" />
		<Item href="AutoRetryIcon.(WidgetPanel).xdb" />
	</Children>
</WidgetButton>
